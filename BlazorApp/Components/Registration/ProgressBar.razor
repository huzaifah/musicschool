@* Progress bar untuk borang pendaftaran 5 atau 6 langkah *@
@using BlazorApp.Data.Enums
@using BlazorApp.Models

<div class="progress-kawaii">
    @for (int i = 1; i <= TotalSteps; i++)
    {
        var step = i;
        var isActive = step == CurrentStep;
        var isCompleted = step < CurrentStep;
        var cssClass = isActive ? "active" : isCompleted ? "completed" : "";

        <div class="progress-step @cssClass">
            <div class="step-circle">
                @if (isCompleted)
                {
                    <span>✓</span>
                }
                else
                {
                    @step
                }
            </div>
            <span class="step-label">@GetStepLabel(step)</span>
        </div>
    }
</div>

@code {
    [Parameter]
    public int CurrentStep { get; set; } = 1;

    [Parameter]
    public int TotalSteps { get; set; } = 5;

    [Parameter]
    public Venue? SelectedVenue { get; set; }

    private bool HasSlotSelection =>
        SelectedVenue.HasValue &&
        VenueConfiguration.GetVenue(SelectedVenue.Value)?.HasSlotSelection == true;

    private string GetStepLabel(int step)
    {
        if (TotalSteps == 6)
        {
            // 6 steps: Tempat → Pelajar → Penjaga → Alamat → Kelas → Semakan
            return step switch
            {
                1 => "Tempat",
                2 => "Pelajar",
                3 => "Penjaga",
                4 => "Alamat",
                5 => "Kelas",
                6 => "Semakan",
                _ => ""
            };
        }
        else
        {
            // 5 steps: Tempat → Pelajar → Penjaga → Alamat → Semakan (no Kelas)
            return step switch
            {
                1 => "Tempat",
                2 => "Pelajar",
                3 => "Penjaga",
                4 => "Alamat",
                5 => "Semakan",
                _ => ""
            };
        }
    }
}
