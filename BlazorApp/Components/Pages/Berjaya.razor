@page "/berjaya/{ReferenceNumber}"
@layout BlazorApp.Components.Layout.RegistrationLayout
@using BlazorApp.Data.Entities
@using BlazorApp.Services.Interfaces
@inject IRegistrationService RegistrationService
@rendermode InteractiveServer

<PageTitle>Pendaftaran Berjaya - NADIRITMA</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            @if (registration == null && !isLoading)
            {
                <div class="card-kawaii text-center">
                    <div class="fs-1 mb-3">😕</div>
                    <h3>Pendaftaran Tidak Dijumpai</h3>
                    <p class="text-muted">Maaf, kami tidak dapat mencari pendaftaran dengan nombor rujukan ini.</p>
                    <a href="/" class="btn-kawaii mt-3">Kembali ke Laman Utama</a>
                </div>
            }
            else if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-kawaii mx-auto"></div>
                    <p class="mt-3 text-muted">Memuatkan...</p>
                </div>
            }
            else
            {
                <div class="success-container">
                    <!-- Success Animation -->
                    <div class="success-icon animate-bounce">
                        ✅
                    </div>

                    <h1 class="success-title">Tahniah!</h1>
                    <p class="lead text-muted mb-4">Pendaftaran anda telah berjaya dihantar.</p>

                    <!-- Reference Number -->
                    <div class="reference-number">
                        <small style="opacity: 0.9;">Nombor Rujukan</small>
                        <br />
                        <span>@registration!.ReferenceNumber</span>
                    </div>

                    <!-- Registration Details -->
                    <div class="card-kawaii mt-4 text-start">
                        <h5 class="mb-3" style="color: var(--kawaii-pink-dark); font-weight: 700;">
                            📋 Ringkasan Pendaftaran
                        </h5>

                        <div class="review-item">
                            <span class="review-label">Nama Pelajar</span>
                            <span class="review-value">@registration.StudentName</span>
                        </div>
                        <div class="review-item">
                            <span class="review-label">Slot Kelas</span>
                            <span class="review-value">@registration.ClassSlot</span>
                        </div>
                        <div class="review-item">
                            <span class="review-label">E-mel Penjaga</span>
                            <span class="review-value">@registration.GuardianEmail</span>
                        </div>
                        <div class="review-item">
                            <span class="review-label">Tarikh Pendaftaran</span>
                            <span class="review-value">@registration.CreatedAt.ToString("dd MMMM yyyy, h:mm tt")</span>
                        </div>
                    </div>

                    <!-- Email Notification -->
                    <div class="card-kawaii mt-4" style="background: var(--kawaii-lavender);">
                        <div class="d-flex align-items-start gap-3">
                            <span class="fs-3">📧</span>
                            <div class="text-start">
                                <h6 class="mb-1" style="font-weight: 700;">E-mel Pengesahan</h6>
                                <p class="mb-0 small text-muted">
                                    E-mel pengesahan akan dihantar ke <strong>@registration.GuardianEmail</strong>.
                                    Sila semak folder spam jika tidak menerima e-mel dalam masa 24 jam.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Next Steps -->
                    <div class="card-kawaii mt-4 text-start">
                        <h5 class="mb-3" style="color: var(--kawaii-pink-dark); font-weight: 700;">
                            📌 Langkah Seterusnya
                        </h5>
                        <ol class="ps-3">
                            <li class="mb-2">Tunggu e-mel pengesahan daripada kami.</li>
                            <li class="mb-2">Kami akan menghubungi anda untuk pengesahan slot kelas.</li>
                            <li class="mb-2">Sediakan yuran pendaftaran sebanyak <strong>RM150</strong> untuk bulan pertama.</li>
                            <li class="mb-0">Hadir ke kelas pada tarikh yang ditetapkan.</li>
                        </ol>
                    </div>

                    <!-- Contact Info -->
                    <div class="card-kawaii mt-4" style="background: var(--kawaii-gradient); color: white;">
                        <h6 class="mb-2" style="font-weight: 700;">Ada Soalan?</h6>
                        <p class="mb-2 small">Hubungi kami jika ada sebarang pertanyaan:</p>
                        <p class="mb-0">
                            📞 <a href="tel:+60103362284" style="color: white;">010-336 2284</a> (Cikgu Zulkifli Shah)
                            <br />
                            📧 <a href="mailto:nadiritma@outlook.my" style="color: white;">nadiritma@outlook.my</a>
                        </p>
                    </div>

                    <!-- Back Button -->
                    <a href="/" class="btn-kawaii mt-4 d-inline-block">
                        🏠 Kembali ke Laman Utama
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .review-item {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    }

    .review-item:last-child {
        border-bottom: none;
    }

    .review-label {
        color: var(--kawaii-text-light);
    }

    .review-value {
        font-weight: 600;
        text-align: right;
    }
</style>

@code {
    [Parameter]
    public string ReferenceNumber { get; set; } = string.Empty;

    private Registration? registration;
    private bool isLoading = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadRegistration();
            StateHasChanged();
        }
    }

    private async Task LoadRegistration()
    {
        try
        {
            registration = await RegistrationService.GetByReferenceAsync(ReferenceNumber);
        }
        catch
        {
            registration = null;
        }
        finally
        {
            isLoading = false;
        }
    }
}
