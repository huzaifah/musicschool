@page "/"
@layout BlazorApp.Components.Layout.RegistrationLayout
@using BlazorApp.Data.Enums
@using BlazorApp.Models
@rendermode InteractiveServer

<PageTitle>NADIRITMA - Kelas Muzik Keyboard</PageTitle>

<!-- Loading Overlay - Shows until SignalR connection is ready -->
<div class="loading-overlay @(isInteractive ? "hidden" : "")">
    <div class="loading-overlay-content">
        <div class="spinner-kawaii"></div>
        <p>Memuatkan...</p>
    </div>
</div>

<!-- Hero Section -->
<section class="hero-kawaii">
    <div class="container">
        <div class="hero-icon animate-bounce" style="pointer-events: none;">🎹</div>
        <h1>Kelas Muzik (Keyboard)</h1>
        <p class="mb-4">Asah bakat muzik anak anda bersama kami!</p>

        <!-- Venue Selection Cards -->
        <div class="venue-selector mb-4">
            <p class="venue-label mb-3">📍 Pilih Lokasi Kelas:</p>
            <div class="venue-cards">
                @foreach (var venue in VenueConfiguration.AllVenues)
                {
                    var isSelected = selectedVenue == venue.Venue;
                    <div class="venue-card @(isSelected ? "active" : "")"
                         @onclick="@(() => SelectVenue(venue.Venue))">
                        <div class="venue-card-icon">@(venue.Venue == Venue.SriAlAminCherasSelatan ? "🏫" : "🏠")</div>
                        <div class="venue-card-name">@venue.ShortName</div>
                        <div class="venue-card-address">@venue.Address</div>
                        @if (isSelected)
                        {
                            <div class="venue-card-check">✓</div>
                        }
                    </div>
                }
            </div>
        </div>

        <a href="/daftar" class="btn-kawaii" data-enhance-nav="true">
            Daftar Sekarang
        </a>
    </div>
</section>

<!-- Info Cards -->
<section class="container">
    <div class="info-grid">
        <div class="info-card">
            <div class="icon">📅</div>
            <h3>Jadual Kelas</h3>
            <p>@GetScheduleDisplay()</p>
        </div>
        <div class="info-card">
            <div class="icon">💰</div>
            <h3>Yuran Bulanan</h3>
            <p>RM150/bulan</p>
        </div>
        <div class="info-card">
            <div class="icon">📍</div>
            <h3>Lokasi</h3>
            <p>@GetLocationDisplay()</p>
        </div>
        <div class="info-card">
            <div class="icon">👨‍🏫</div>
            <h3>Pengajar Berpengalaman</h3>
            <p>15+ tahun pengalaman<br/>dalam pengajaran muzik</p>
        </div>
    </div>
</section>

<!-- Benefits Section -->
<section class="container my-5">
    <h2 class="text-center mb-4" style="color: var(--kawaii-pink-dark); font-weight: 700;">
        Kenapa Pilih Kami?
    </h2>
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card-kawaii d-flex align-items-start gap-3">
                <span class="fs-2">🎯</span>
                <div>
                    <h5 style="font-weight: 700;">Pembelajaran Terstruktur</h5>
                    <p class="mb-0 text-muted">Kurikulum yang direka khas untuk kanak-kanak berusia 8 - 12 tahun</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card-kawaii d-flex align-items-start gap-3">
                <span class="fs-2">🎵</span>
                <div>
                    <h5 style="font-weight: 700;">Asas yang Kukuh</h5>
                    <p class="mb-0 text-muted">Membina asas muzik yang kukuh dari peringkat awal</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card-kawaii d-flex align-items-start gap-3">
                <span class="fs-2">🏆</span>
                <div>
                    <h5 style="font-weight: 700;">Peluang Persembahan</h5>
                    <p class="mb-0 text-muted">Pelajar berpeluang membuat persembahan di majlis tahunan</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card-kawaii d-flex align-items-start gap-3">
                <span class="fs-2">👥</span>
                <div>
                    <h5 style="font-weight: 700;">Kelas Kecil</h5>
                    <p class="mb-0 text-muted">Perhatian lebih dengan kelas bersaiz kecil (maksimum 10 pelajar)</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Instructor Section -->
<section class="container my-5">
    <div class="card-kawaii">
        <div class="row align-items-center">
            <div class="col-md-4 text-center mb-4 mb-md-0">
                <div class="instructor-avatar" style="width: 150px; height: 150px; border-radius: 50%; background: var(--kawaii-gradient); display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                    <span style="font-size: 4rem;">🎼</span>
                </div>
            </div>
            <div class="col-md-8">
                <h3 style="color: var(--kawaii-pink-dark); font-weight: 700;">Cikgu Zulkifli Shah</h3>
                <p class="text-muted mb-3">Pengajar Muzik Keyboard</p>
                <ul class="list-unstyled">
                    <li class="mb-2">✅ 15+ tahun pengalaman mengajar muzik</li>
                    <li class="mb-2">✅ Berpengalaman dengan pelajar kanak-kanak</li>
                    <li class="mb-2">✅ Pendekatan mesra dan sabar</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- FAQ Section -->
<section class="container my-5">
    <h2 class="text-center mb-4" style="color: var(--kawaii-pink-dark); font-weight: 700;">
        Soalan Lazim (FAQ)
    </h2>
    <div class="accordion accordion-kawaii" id="faqAccordion">
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                    Apakah umur yang sesuai untuk memulakan kelas?
                </button>
            </h2>
            <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                <div class="accordion-body">
                    Kelas kami direka khas untuk kanak-kanak berusia 8 - 12 tahun. Pada usia ini, kanak-kanak sudah mempunyai koordinasi motor yang mencukupi dan boleh mengikuti arahan dengan baik.
                </div>
            </div>
        </div>
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                    Adakah pelajar perlu mempunyai keyboard sendiri di rumah?
                </button>
            </h2>
            <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                <div class="accordion-body">
                    Adalah digalakkan untuk pelajar mempunyai keyboard di rumah untuk berlatih. Namun, ia tidak wajib pada peringkat permulaan. Kami boleh memberi panduan tentang jenis keyboard yang sesuai apabila pelajar sudah bersedia.
                </div>
            </div>
        </div>
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                    Berapa lama satu sesi kelas?
                </button>
            </h2>
            <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                <div class="accordion-body">
                    Setiap sesi kelas berlangsung selama 30 minit hingga 1 jam bergantung kepada lokasi. Ini termasuk teori asas, latihan praktikal, dan permainan lagu.
                </div>
            </div>
        </div>
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
                    Bagaimana cara pembayaran yuran?
                </button>
            </h2>
            <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                <div class="accordion-body">
                    Yuran bulanan sebanyak RM150 perlu dibayar sebelum atau pada minggu pertama setiap bulan. Pembayaran boleh dibuat melalui pemindahan bank online (online transfer).
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="container my-5 text-center">
    <div class="card-kawaii" style="background: var(--kawaii-gradient); color: white;">
        <h3 class="mb-3" style="font-weight: 700;">Bersedia untuk Bermula?</h3>
        <p class="mb-4">Daftarkan anak anda sekarang dan mulakan perjalanan muzik mereka!</p>
        <a href="/daftar" class="btn-kawaii" style="background: white; color: var(--kawaii-pink-dark);" data-enhance-nav="true">
            Daftar Sekarang
        </a>
    </div>
</section>

<!-- Footer -->
<footer class="footer-kawaii">
    <div class="container">
        <div class="mb-3">
            <span style="font-size: 2rem;">🎹</span>
            <h4 class="d-inline-block mb-0 ms-2" style="font-weight: 700;">NADIRITMA</h4>
        </div>
        <p class="mb-2">Kelas Muzik Keyboard untuk Kanak-kanak</p>
        <p class="mb-3">
            📞 <a href="tel:+60103362284">010-336 2284</a> (Admin)<br/>
            📧 <a href="mailto:nadiritma@outlook.my">nadiritma@outlook.my</a>
        </p>
        <p class="mb-0" style="font-size: 0.9rem; opacity: 0.8;">
            &copy; 2026 NADIRITMA ENTERPRISE. Hak cipta terpelihara.
        </p>
    </div>
</footer>

<style>
    .hero-icon {
        font-size: 4rem;
        margin-bottom: 20px;
    }

    .venue-selector {
        max-width: 600px;
        margin: 0 auto;
    }

    .venue-label {
        font-size: 1.1rem;
        font-weight: 600;
        color: white;
    }

    .venue-cards {
        display: flex;
        gap: 15px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .venue-card {
        background: rgba(255, 255, 255, 0.15);
        border: 3px solid rgba(255, 255, 255, 0.5);
        border-radius: 15px;
        padding: 15px 25px;
        cursor: pointer;
        transition: all 0.3s ease;
        min-width: 200px;
        text-align: center;
        position: relative;
    }

    .venue-card:hover {
        background: rgba(255, 255, 255, 0.25);
        transform: translateY(-3px);
    }

    .venue-card.active {
        background: white;
        border-color: white;
        color: var(--kawaii-pink-dark);
    }

    .venue-card-icon {
        font-size: 2rem;
        margin-bottom: 5px;
    }

    .venue-card-name {
        font-weight: 700;
        font-size: 1.1rem;
        margin-bottom: 3px;
    }

    .venue-card-address {
        font-size: 0.85rem;
        opacity: 0.8;
    }

    .venue-card.active .venue-card-address {
        color: var(--kawaii-text-light);
    }

    .venue-card-check {
        position: absolute;
        top: -8px;
        right: -8px;
        background: var(--kawaii-pink-dark);
        color: white;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        font-weight: bold;
    }

    @@media (max-width: 480px) {
        .venue-card {
            min-width: 100%;
        }
    }
</style>

@code {
    private Venue selectedVenue = Venue.SriAlAminCherasSelatan;
    private bool isInteractive = false;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            isInteractive = true;
            StateHasChanged();
        }
    }

    private VenueConfiguration? SelectedVenueConfig =>
        VenueConfiguration.GetVenue(selectedVenue);

    private void SelectVenue(Venue venue)
    {
        selectedVenue = venue;
    }

    private MarkupString GetScheduleDisplay()
    {
        var config = SelectedVenueConfig;
        if (config == null) return (MarkupString)"-";

        if (config.HasSlotSelection)
        {
            return (MarkupString)config.ScheduleDisplay.Replace("\n", "<br/>");
        }
        else
        {
            return (MarkupString)$"<em>{config.ScheduleDisplay}</em>";
        }
    }

    private MarkupString GetLocationDisplay()
    {
        var config = SelectedVenueConfig;
        if (config == null) return (MarkupString)"-";

        return (MarkupString)$"{config.Name}<br/>{config.Address}";
    }
}

