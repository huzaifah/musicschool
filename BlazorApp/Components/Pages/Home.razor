    <div class="container">
        <div class="hero-icon animate-bounce" style="pointer-events: none;">🎹</div>
        <h1>Kelas Muzik (Keyboard)</h1>
        <p class="mb-4">Asah bakat muzik anak anda bersama kami!</p>
        <a href="/daftar" class="btn-kawaii" data-enhance-nav="true">
            Daftar Sekarang
        </a>
    </div>
</section>

<!-- Info Cards -->
<section class="container">
    <div class="info-grid">
        <div class="info-card">
            <div class="icon">📅</div>
            <h3>Jadual Kelas</h3>
            <p>Rabu (4:00 ptg - 5:00 ptg)<br/>Sabtu (11:30 pagi - 12:30 tghari)<br/>Ahad (10:00 pagi - 11:00 pagi)</p>
        </div>
        <div class="info-card">
            <div class="icon">💰</div>
            <h3>Yuran Bulanan</h3>
            <p>RM150/bulan</p>
        </div>
        <div class="info-card">
            <div class="icon">📍</div>
            <h3>Lokasi</h3>
            <p>SRI AL-AMIN Cheras Selatan<br/>43200 Cheras, Selangor</p>
        </div>
        <div class="info-card">
